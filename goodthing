local function UpdateButton(Button, Name, Value)
    Button.Text = Name .. (Value and ": ON" or ": OFF")
    Button.BackgroundColor3 = Value
        and Color3.fromRGB(70, 180, 110)
        or Color3.fromRGB(255, 70, 70)
end

