local Dragging = false
local DragStart
local StartPos

Title.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 then
        Dragging = true
        DragStart = Input.Position
        StartPos = Main.Position
    end
end)

Title.InputEnded:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 then
        Dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(Input)
    if Dragging and Input.UserInputType == Enum.UserInputType.MouseMovement then
        local Delta = Input.Position - DragStart

        Main.Position = UDim2.new(
            StartPos.X.Scale,
            StartPos.X.Offset + Delta.X,
            StartPos.Y.Scale,
            StartPos.Y.Offset + Delta.Y
        )
    end
end)

local function GetRoot()
    local Character = Player.Character or Player.CharacterAdded:Wait()
    return Character:WaitForChild("HumanoidRootPart")
end

local function GetClosestCritter()
    local Critters = workspace:FindFirstChild("Critters")

    if not Critters then
        return nil, nil, nil
    end

    local HRP = GetRoot()
    local ClosestPart = nil
    local ClosestDistance = math.huge
    local ClosestName = nil

    for _, Obj in ipairs(Critters:GetChildren()) do
        local Part

        if Obj:IsA("Model") then
            Part = Obj.PrimaryPart or Obj:FindFirstChildWhichIsA("BasePart")
        elseif Obj:IsA("BasePart") then
            Part = Obj
        end

        if Part then
            local Distance = (HRP.Position - Part.Position).Magnitude

            if Distance < ClosestDistance then
                ClosestDistance = Distance
                ClosestPart = Part
                ClosestName = Obj.Name
            end
        end
    end

    return ClosestPart, ClosestDistance, ClosestName
end

task.spawn(function()
    while task.wait(0.2) do
        if Enabled then
            local HRP = GetRoot()
            local Target, Distance, CritterName = GetClosestCritter()

            if Target and HRP then
                Status.Text = "Target: " .. tostring(CritterName)

                local Time = math.max(Distance / 17, 0.1)

                local Tween = TweenService:Create(
                    HRP,
                    TweenInfo.new(Time, Enum.EasingStyle.Linear),
                    {
                        CFrame = CFrame.new(
                            Target.Position.X,
                            HRP.Position.Y,
                            Target.Position.Z
                        )
                    }
                )

                Tween:Play()
            end
        end
    end
end)
