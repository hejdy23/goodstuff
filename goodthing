-- Find the closest critter
local function GetClosestCritter()
    local Critters = workspace:FindFirstChild("Critters")
    if not Critters then
        return nil, nil, nil
    end

    local Character = Player.Character
    local HRP = Character
        and Character:FindFirstChild("HumanoidRootPart")

    if not HRP then
        return nil, nil, nil
    end

    local ClosestPart
    local ClosestDistance = math.huge
    local ClosestName

    for _, Obj in ipairs(Critters:GetChildren()) do
        local Part

        if Obj:IsA("Model") then
            Part = Obj.PrimaryPart
                or Obj:FindFirstChildWhichIsA("BasePart")
        elseif Obj:IsA("BasePart") then
            Part = Obj
        end

        if Part then
            local Distance = (HRP.Position - Part.Position).Magnitude

            if Distance < ClosestDistance then
                ClosestDistance = Distance
                ClosestPart = Part
                ClosestName = Obj.Name
            end
        end
    end

    return ClosestPart, ClosestDistance, ClosestName
end

-- Critter tweening loop
task.spawn(function()
    while ScreenGui.Parent do
        task.wait(0.2)

        if Enabled then
            local Character = Player.Character
            local HRP = Character
                and Character:FindFirstChild("HumanoidRootPart")

            local Target, Distance, CritterName = GetClosestCritter()

            if Target and HRP then
                Status.Text = "Target: " .. tostring(CritterName)

                local Time = math.max(Distance / 17, 0.1)

                local Tween = TweenService:Create(
                    HRP,
                    TweenInfo.new(Time, Enum.EasingStyle.Linear),
                    {
                        CFrame = CFrame.new(
                            Target.Position.X,
                            HRP.Position.Y,
                            Target.Position.Z
                        )
                    }
                )

                Tween:Play()
            else
                Status.Text = "Target: None"
            end
        else
            Status.Text = "Target: None"
        end
    end
end)
